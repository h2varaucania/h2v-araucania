# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.production
.env*.local

# keep example
!.env.example

# uploads (CMS managed)
/public/uploads

# payload generated — SÍ se commitea: el código lo importa (@/payload-types) y el
# build de Vercel (checkout limpio) lo necesita. Regenerar con `npm run payload:generate`
# tras cambiar colecciones/globals.

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# higiene pre-push (EDITABILIDAD_TOTAL §6)
*recovery-codes*

# Manual de usuario: capturas crudas y auxiliares LaTeX (regenerables)
docs/manual-usuario/capturas/*.png
docs/manual-usuario/salida/
docs/manual-usuario/herramientas/__pycache__/
